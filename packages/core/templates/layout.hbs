<!doctype html>
<html lang="{{lang}}"{{#if darkModeClass}} class="{{darkModeClass}}"{{/if}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    {{#if description}}
    <meta name="description" content="{{description}}" />
    {{/if}}
    {{#if noindex}}
    <meta name="robots" content="noindex, follow" />
    {{/if}}
    {{#if canonical}}
    <link rel="canonical" href="{{canonical}}" />
    {{/if}}
    {{#if feedUrl}}
    <link rel="alternate" type="application/rss+xml" title="{{projectName}}" href="{{feedUrl}}" />
    {{/if}}
    {{#if favicon}}
    <link rel="icon" href="{{favicon.href}}" type="{{favicon.type}}" />
    {{/if}}
    {{!-- What a social network shows of a shared page. Only with a preview
    image: without one, the title and description alone are read anyway. --}}
    {{#if socialImage}}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{projectName}}" />
    <meta property="og:title" content="{{title}}" />
    {{#if description}}
    <meta property="og:description" content="{{description}}" />
    {{/if}}
    <meta property="og:url" content="{{canonical}}" />
    <meta property="og:image" content="{{socialImage}}" />
    <meta name="twitter:card" content="summary_large_image" />
    {{/if}}
    {{#each preloads}}
    <link rel="preload" as="{{as}}" href="{{href}}" />
    {{/each}}
    <link rel="stylesheet" href="{{cssHref}}" />
    {{#if schemeToggle}}
    {{!-- Before the first paint: the scheme the reader chose, not a flash of the
    other one. --}}
    <script>try{var s=localStorage.getItem('dp-scheme'),c=document.documentElement.classList;if(s==='dark'||s==='light'){c.remove('dark','light');c.add(s)}}catch(e){}</script>
    {{/if}}
    {{!-- Only the search page carries a script: content pages load none. --}}
    {{#each scripts}}
    <script type="module" src="{{this}}"></script>
    {{/each}}
    {{{jsonld}}}
  </head>
  <body>
    <a class="{{{cls.skip}}}" href="#content">{{ui.skipToContent}}</a>

    {{!-- Target of the back-to-top link: it brings the focus back, not only the
    view. It stays out of the header on purpose — the header is sticky, so it
    is already in view at any scroll position, and a browser asked to bring it
    into view scrolled nowhere. --}}
    <div id="top" tabindex="-1"></div>

    <header class="{{#if stickyHeader}}{{{cls.header}}}{{else}}{{{cls.headerStatic}}}{{/if}}">
      {{!-- The logo's alt stays empty: the name that follows already says it. --}}
      <a class="{{{cls.brand}}}" href="{{homeUrl}}">{{#if logoUrl}}<img class="{{{cls.brandLogo}}}" src="{{logoUrl}}" alt="" />{{/if}}{{projectName}}</a>
      {{!-- Shown twice, one at a time: in a row on a wide screen, behind a button
      on a narrow one. The button is a details element, so that the menu opens
      without a script — as the version switcher does. --}}
      {{#if headerMenu}}
      <nav class="{{{cls.headerNav}}}" aria-label="{{ui.site}}">
        {{> headerMenu}}
      </nav>
      <details class="{{{cls.menu}}}">
        <summary aria-label="{{ui.menu}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav class="{{{cls.menuPanel}}}" aria-label="{{ui.site}}">
          {{> headerMenu}}
        </nav>
      </details>
      {{/if}}
      {{!-- Hidden until its script runs: without JavaScript, it would do nothing. --}}
      {{#if schemeToggle}}
      <button class="{{{cls.schemeToggle}}}" type="button" data-scheme-toggle hidden aria-label="{{ui.switchScheme}}">
        <svg class="dp-scheme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="dp-scheme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      {{/if}}
    </header>

    <div class="{{#if wide}}{{{cls.shellWide}}}{{else}}{{{cls.shell}}}{{/if}}">
      {{!-- Written once, shown twice: the column on a wide screen, and a folded
      menu above the content on a narrow one, where a full menu would eat the
      first screen. Only one of the two is displayed at a time. --}}
      {{#if sidebar.length}}
      <nav class="{{{cls.sidebar}}}" aria-label="{{ui.documentationNavigation}}">
        {{> navItems sidebar}}
      </nav>
      <details class="{{{cls.sidebarMenu}}}">
        <summary>{{ui.documentationMenu}}</summary>
        <nav aria-label="{{ui.documentationNavigation}}">
          {{> navItems sidebar}}
        </nav>
      </details>
      {{/if}}

      <main class="{{{cls.main}}}" id="content" tabindex="-1">
        {{#if notice}}
        <aside class="{{{cls.notice}}}" role="note">
          {{#if notice.prerelease}}
          {{ui.prereleaseNotice}}
          {{else}}
          {{ui.archivedNotice}}
          {{/if}}
          {{ui.currentVersionIs}} <a href="{{notice.url}}">{{notice.name}}</a>.
        </aside>
        {{/if}}
        {{!-- Who wrote the page, and when. Absent when the page says neither,
        and on a home page, where a byline under an entrance hall means
        nothing. --}}
        {{#if byline}}
        <div class="{{{cls.byline}}}">
          {{#if byline.authors.length}}
          <ul class="{{{cls.bylineAuthors}}}">
            {{#each byline.authors}}
            <li class="{{{@root.cls.bylineAuthor}}}">
              {{#if avatarUrl}}<img class="{{{@root.cls.bylineAvatar}}}" src="{{avatarUrl}}" alt="" {{#if avatarWidth}}width="{{avatarWidth}}" height="{{avatarHeight}}" {{/if}}loading="lazy" decoding="async" />{{/if}}
              <span class="{{{@root.cls.bylineName}}}">{{#if url}}<a href="{{url}}">{{name}}</a>{{else}}{{name}}{{/if}}</span>
              {{#if bio}}<span class="{{{@root.cls.bylineBio}}}">{{bio}}</span>{{/if}}
            </li>
            {{/each}}
          </ul>
          {{/if}}
          {{#if byline.dates.length}}
          <p class="{{{cls.bylineDates}}}">
            {{#each byline.dates}}<span>{{prefix}} <time datetime="{{iso}}">{{label}}</time></span>{{/each}}
          </p>
          {{/if}}
        </div>
        {{/if}}
        <article class="{{{cls.article}}}">{{{content}}}</article>
        {{!-- The tags of the page, below what they describe: read after the
        text, they say what it was about. Labels, not links — there is no page
        per tag. None on a home page. --}}
        {{#if tags.length}}
        <ul class="{{{cls.tags}}}" aria-label="{{ui.tags}}">
          {{#each tags}}<li class="{{{@root.cls.tag}}}">{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </main>

      {{#if toc.length}}
      <nav class="{{{cls.toc}}}" aria-label="{{ui.onThisPage}}">
        <p class="{{{cls.tocTitle}}}">{{ui.onThisPage}}</p>
        {{> tocItems toc}}
      </nav>
      {{/if}}
    </div>

    <footer class="{{{cls.footer}}}">
      <p>{{projectName}} — {{ui.versionLabel}} {{versionName}}</p>
    </footer>

    {{#if scrollToTop}}
    <a class="{{{cls.scrollTop}}}" href="#top" aria-label="{{ui.backToTop}}">
      <svg
        class="{{{cls.scrollTopIcon}}}"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 19V5" />
        <path d="m5 12 7-7 7 7" />
      </svg>
    </a>
    {{/if}}
    {{#if schemeToggle}}
    <script>(function(){var b=document.querySelector('[data-scheme-toggle]');if(!b)return;var r=document.documentElement.classList;function dark(){return r.contains('dark')||(!r.contains('light')&&matchMedia('(prefers-color-scheme: dark)').matches)}function label(){b.setAttribute('aria-label',dark()?'Switch to light mode':'Switch to dark mode')}b.hidden=false;label();b.addEventListener('click',function(){var next=dark()?'light':'dark';r.remove('dark','light');r.add(next);try{localStorage.setItem('dp-scheme',next)}catch(e){}label()})})();</script>
    {{/if}}
  </body>
</html>
