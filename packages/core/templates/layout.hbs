<!doctype html>
<html lang="{{lang}}"{{#if darkModeClass}} class="{{darkModeClass}}"{{/if}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    {{#if description}}
    <meta name="description" content="{{description}}" />
    {{/if}}
    {{#if noindex}}
    <meta name="robots" content="noindex, follow" />
    {{/if}}
    {{#if canonical}}
    <link rel="canonical" href="{{canonical}}" />
    {{/if}}
    {{#if feedUrl}}
    <link rel="alternate" type="application/rss+xml" title="{{projectName}}" href="{{feedUrl}}" />
    {{/if}}
    {{#if favicon}}
    <link rel="icon" href="{{favicon.href}}" type="{{favicon.type}}" />
    {{/if}}
    {{!-- What a social network shows of a shared page. Only with a preview
    image: without one, the title and description alone are read anyway. --}}
    {{#if socialImage}}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{projectName}}" />
    <meta property="og:title" content="{{title}}" />
    {{#if description}}
    <meta property="og:description" content="{{description}}" />
    {{/if}}
    <meta property="og:url" content="{{canonical}}" />
    <meta property="og:image" content="{{socialImage}}" />
    <meta name="twitter:card" content="summary_large_image" />
    {{/if}}
    {{#each preloads}}
    <link rel="preload" as="{{as}}" href="{{href}}" />
    {{/each}}
    <link rel="stylesheet" href="{{cssHref}}" />
    {{!-- Only the search page carries a script: content pages load none. --}}
    {{#each scripts}}
    <script type="module" src="{{this}}"></script>
    {{/each}}
    {{{jsonld}}}
  </head>
  <body>
    <a class="{{{cls.skip}}}" href="#content">Skip to content</a>

    {{!-- Target of the back-to-top link: bring the focus back, not only the view. --}}
    <header class="{{{cls.header}}}" id="top" tabindex="-1">
      {{!-- The logo's alt stays empty: the name that follows already says it. --}}
      <a class="{{{cls.brand}}}" href="{{homeUrl}}">{{#if logoUrl}}<img class="{{{cls.brandLogo}}}" src="{{logoUrl}}" alt="" />{{/if}}{{projectName}}</a>
      {{#if showVersions}}
      <details class="{{{cls.versions}}}">
        {{!-- The accessible name contains the visible label: when dictated by
        voice, what is read on screen must find this button. --}}
        <summary aria-label="Version {{versionName}}, switch version">{{versionName}}</summary>
        <ul class="{{{cls.versionsList}}}">
          {{#each versions}}
          <li><a href="{{url}}"{{#if current}} aria-current="true"{{/if}}>{{name}}</a></li>
          {{/each}}
        </ul>
      </details>
      {{/if}}
      {{!-- A plain form: it leads to the search page, and needs no script. --}}
      {{#if searchUrl}}
      <form class="{{{cls.search}}}" role="search" action="{{searchUrl}}">
        <input type="search" name="q" placeholder="Search" aria-label="Search the documentation" />
      </form>
      {{/if}}
    </header>

    <div class="{{#if wide}}{{{cls.shellWide}}}{{else}}{{{cls.shell}}}{{/if}}">
      {{#if sidebar.length}}
      <nav class="{{{cls.sidebar}}}" aria-label="Documentation navigation">
        {{> navItems sidebar}}
      </nav>
      {{/if}}

      <main class="{{{cls.main}}}" id="content" tabindex="-1">
        {{#if notice}}
        <aside class="{{{cls.notice}}}" role="note">
          {{#if notice.prerelease}}
          This version is in preparation and may change.
          {{else}}
          This version is no longer maintained.
          {{/if}}
          The current version is <a href="{{notice.url}}">{{notice.name}}</a>.
        </aside>
        {{/if}}
        <article class="{{{cls.article}}}">{{{content}}}</article>
      </main>

      {{#if toc.length}}
      <nav class="{{{cls.toc}}}" aria-label="On this page">
        <p class="{{{cls.tocTitle}}}">On this page</p>
        {{> tocItems toc}}
      </nav>
      {{/if}}
    </div>

    <footer class="{{{cls.footer}}}">
      <p>{{projectName}} — version {{versionName}}</p>
    </footer>

    {{#if scrollToTop}}
    <a class="{{{cls.scrollTop}}}" href="#top" aria-label="Back to top">
      <svg
        class="{{{cls.scrollTopIcon}}}"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 19V5" />
        <path d="m5 12 7-7 7 7" />
      </svg>
    </a>
    {{/if}}
  </body>
</html>
