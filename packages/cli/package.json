{
  "name": "docpensieve",
  "version": "0.2.0-beta.1",
  "description": "DocPensieve command-line interface (init, build, check, dev, serve)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "docpensieve": "bin/docpensieve.js"
  },
  "files": [
    "bin",
    "src",
    "starter",
    "types"
  ],
  "dependencies": {
    "@docpensieve/components": "0.2.0-beta.1",
    "@docpensieve/core": "0.2.0-beta.1",
    "@docpensieve/shared": "0.2.0-beta.1",
    "@docpensieve/theme": "0.2.0-beta.1",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0"
  },
  "keywords": [
    "docpensieve",
    "cli",
    "documentation",
    "static-site-generator",
    "mdx",
    "ssg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juniors017/docpensieve.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docpensieve.com",
  "bugs": {
    "url": "https://github.com/Juniors017/docpensieve/issues"
  },
  "author": "Valentin Chevoleau (Juniors017)",
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json && node scripts/starter.mjs",
    "postpack": "node scripts/starter.mjs --clean"
  }
}
