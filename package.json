{
  "name": "docpensieve-monorepo",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Static documentation site generator — MDX, versions on orphan branches, extensible themes, JSON-LD",
  "license": "MIT",
  "author": "Valentin Chevoleau (Juniors017)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node packages/cli/bin/docpensieve.js build",
    "dev": "node packages/cli/bin/docpensieve.js dev",
    "serve": "node packages/cli/bin/docpensieve.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "types": "npm run prepack --workspaces --if-present",
    "check:links": "node packages/cli/bin/docpensieve.js check",
    "deploy:versions": "node scripts/publish-versions.mjs",
    "version:all": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juniors017/docpensieve.git"
  },
  "homepage": "https://github.com/Juniors017/docpensieve#readme",
  "bugs": {
    "url": "https://github.com/Juniors017/docpensieve/issues"
  }
}
